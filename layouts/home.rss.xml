{{- /* 全文 RSS;外语站输出中文文章,与首页约定一致 */ -}}
{{- $contentSite := site -}}
{{- if ne site.Language.Lang "zh-cn" }}{{- $contentSite = index site.Sites 0 -}}{{- end -}}
{{- $pages := $contentSite.RegularPages -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description | default .Site.Params.description }}{{ . | plainify }}{{ end }}</description>
    <language>{{ site.Language.Lang }}</language>{{ with .Site.Copyright }}
    <copyright>{{ . | plainify }}</copyright>{{ end }}{{ with .Lastmod }}
    <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink "application/rss+xml" | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
